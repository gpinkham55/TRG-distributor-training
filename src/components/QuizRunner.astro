---
import { u } from '../lib/url';
interface Props { eyebrow: string; title: string; back: string; backLabel: string; module?: number; final?: boolean }
const { eyebrow, title, back, backLabel, module, final } = Astro.props;
---
<div class="prose" id="quiz" data-module={module} data-final={final ? '1' : undefined} data-signin={u('signin')}>
  <p class="eyebrow">{eyebrow}</p>
  <h1 id="q-title">{title}</h1>
  <p id="q-rules" class="meta"></p>
  <div id="q-msg" class="msg hidden" role="status"></div>
  <form id="q-form" class="quiz hidden"></form>
  <div id="q-result" class="complete hidden"></div>
  <p><a href={back}>{backLabel}</a></p>
</div>
  <script>
    import { supabase } from '../lib/supabase';
    const box = document.getElementById('quiz')!;
    const isFinal = box.dataset.final === '1';
    const moduleId = isFinal ? null : Number(box.dataset.module);
    const kind = isFinal ? 'final' : 'module';
    const $ = (id: string) => document.getElementById(id)!;
    const say = (t: string, cls = '') => { const e = $('q-msg'); e.innerHTML = t; e.className = `msg ${cls}`; };
    const shuffle = <T,>(a: T[]) => { for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));

    (async () => {
      if (!supabase) return say('Quizzes are not switched on yet.', 'err');
      const { data: s } = await supabase.auth.getSession();
      if (!s.session) return say(`Sign in to take quizzes. <a href="${box.dataset.signin}">Sign in or register</a>`);

      let qq = supabase.from('quizzes').select('*').eq('kind', kind);
      qq = isFinal ? qq.is('module_id', null) : qq.eq('module_id', moduleId);
      const { data: quiz } = await qq.maybeSingle();
      if (!quiz) return say('This quiz is not ready yet.', 'err');
      $('q-rules').textContent = `${quiz.draw_count} questions · ${quiz.pass_pct}% to pass · ${quiz.max_attempts} ${quiz.max_attempts === 1 ? 'try' : 'tries'}`;

      const { data: tries } = await supabase.from('quiz_attempts').select('score_pct, passed').eq('quiz_id', quiz.id);
      const used = tries?.length || 0;
      const passed = tries?.some((t) => t.passed);
      if (passed) return say(isFinal ? `You passed the final exam with ${Math.max(...tries!.map((t) => t.score_pct))}%. See your Manager for final sign-off.` : `You passed this quiz with ${Math.max(...tries!.map((t) => t.score_pct))}%. Module ${moduleId} is complete.`, 'ok');
      if (used >= quiz.max_attempts) return say(`You have used all ${quiz.max_attempts} ${quiz.max_attempts === 1 ? 'try' : 'tries'}. Talk to your Manager about next steps.`, 'err');
      if (used) say(`Try ${used + 1} of ${quiz.max_attempts}. Your best so far: ${Math.max(...tries!.map((t) => t.score_pct))}%.`);

      let drawn: any[] = [];
      if (isFinal) {
        // Draw evenly from every module quiz pool.
        const { data: mods } = await supabase.from('quizzes').select('id').eq('kind', 'module');
        const ids = (mods || []).map((m) => m.id);
        const { data: pool } = await supabase.from('questions').select('id, prompt, choices, quiz_id').in('quiz_id', ids).limit(5000);
        const per = Math.floor(quiz.draw_count / Math.max(ids.length, 1));
        for (const id of ids) drawn.push(...shuffle((pool || []).filter((q) => q.quiz_id === id)).slice(0, per));
        const used = new Set(drawn.map((q) => q.id));
        drawn.push(...shuffle((pool || []).filter((q) => !used.has(q.id))).slice(0, quiz.draw_count - drawn.length));
        if (drawn.length < quiz.draw_count) return say('The final exam is not ready yet.', 'err');
        drawn = shuffle(drawn);
      } else {
        const { data: pool } = await supabase.from('questions').select('id, prompt, choices, code').eq('quiz_id', quiz.pool_quiz_id || quiz.id);
        if (!pool || pool.length < quiz.draw_count) return say('This quiz is not ready yet.', 'err');
        // Scenario questions (codes ending -S1, -S2, ...) are on every attempt; the rest are drawn at random.
        const scen = pool.filter((q) => /-S\d+$/.test(q.code || ''));
        const rest = pool.filter((q) => !/-S\d+$/.test(q.code || ''));
        drawn = shuffle([...scen.slice(0, quiz.draw_count), ...shuffle(rest).slice(0, Math.max(quiz.draw_count - scen.length, 0))]);
      }

      const form = $('q-form') as HTMLFormElement;
      form.innerHTML = drawn.map((q, n) => {
        const order = shuffle(q.choices.map((_: string, i: number) => i));
        return `<fieldset class="q" data-id="${q.id}"><legend><b>${n + 1}.</b> ${esc(q.prompt)}</legend>` +
          order.map((i: number) => `<label><input type="radio" name="q${q.id}" value="${i}" required> ${esc(q.choices[i])}</label>`).join('') +
          `<p class="q-mark hidden"></p></fieldset>`;
      }).join('') + `<button class="btn" type="submit">Submit answers</button>`;
      form.classList.remove('hidden');

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const answers: Record<string, number[]> = {};
        for (const q of drawn) {
          const v = (form.querySelector(`input[name="q${q.id}"]:checked`) as HTMLInputElement | null)?.value;
          if (v === undefined) return say('Answer every question before you submit.', 'err');
          answers[q.id] = [Number(v)];
        }
        const btn = form.querySelector('button')!; btn.disabled = true;
        const { data, error } = await supabase.rpc('grade_attempt', { p_quiz_id: quiz.id, answers });
        if (error) { btn.disabled = false; return say(error.message, 'err'); }
        const r = data[0];
        const { data: marks } = await supabase.from('attempt_answers').select('question_id, correct').eq('attempt_id', r.attempt_id);
        for (const mk of marks || []) {
          const fs = form.querySelector(`fieldset[data-id="${mk.question_id}"]`)!;
          fs.classList.add(mk.correct ? 'right' : 'wrong');
          const p = fs.querySelector('.q-mark')!; p.textContent = mk.correct ? 'Correct' : 'Not correct'; p.classList.remove('hidden');
        }
        form.querySelectorAll('input').forEach((i) => (i.disabled = true)); btn.remove();
        const left = quiz.max_attempts - used - 1;
        const res = $('q-result');
        res.innerHTML = r.passed
          ? (isFinal ? `<p><b>You scored ${r.score_pct}%. You passed the final exam.</b> See your Manager for final sign-off.</p>` : `<p><b>You scored ${r.score_pct}%. You passed.</b> Module ${moduleId} is marked complete.</p>`)
          : `<p><b>You scored ${r.score_pct}%.</b> You need ${quiz.pass_pct}% to pass. ` +
            (left > 0 ? `You have ${left} ${left === 1 ? 'try' : 'tries'} left. Review, then <a href="">try again</a>; you will get a new set of questions.</p>`
                      : `You have no tries left. Talk to your Manager about next steps.</p>`);
        res.classList.remove('hidden'); $('q-msg').classList.add('hidden');
        res.scrollIntoView({ behavior: 'smooth' });
      });
    })();
  </script>
