---
import Base from '../layouts/Base.astro';
import { SYLLABUS } from '../data/syllabus';
import { u } from '../lib/url';
---
<Base title="Trainee Activity" current="admin">
  <div class="prose wide">
    <h1>Trainee Activity</h1>
    <p id="a-msg" class="msg" data-signin={u('signin')}>Loading…</p>
    <div id="a-in" class="hidden">
      <p>Minutes are reported by the trainee's browser. Time counts while a module or quiz page is open and the trainee has been active in the last 5 minutes. Select a trainee to see each module, then select a quiz score to see the questions and answers.</p>
      <p><button class="btn alt" id="a-csv" type="button">Download CSV</button></p>
      <div class="tw"><table id="a-sum">
        <thead><tr>
          <th>Email</th><th>Name</th><th>Modules complete</th><th>Course minutes</th><th>Quiz minutes</th><th>Total minutes</th>
          <th>Quizzes passed</th><th>Final exam</th><th>Last active</th>
        </tr></thead>
        <tbody></tbody>
      </table></div>
      <div id="a-detail" class="hidden">
        <h2 id="d-title"></h2>
        <div class="tw"><table>
          <thead><tr><th>Module</th><th>Title</th><th>Course minutes</th><th>Quiz minutes</th><th>Quiz attempts</th><th>Best</th><th>Status</th></tr></thead>
          <tbody id="d-body"></tbody>
        </table></div>
        <div id="qa" class="hidden">
          <h3 id="qa-title"></h3>
          <div id="qa-body"></div>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="a-syl" set:html={JSON.stringify(SYLLABUS.map((m) => ({ n: m.n, title: m.title })))}></script>
  <style>
    .wide{max-width:none}
    #a-sum tbody tr{cursor:pointer}
    #a-sum tbody tr:hover,#a-sum tbody tr.sel{background:var(--panel)}
    .pass{color:var(--tip);font-weight:600}
    .fail{color:var(--warn)}
    .try{background:none;border:0;padding:0;cursor:pointer;text-decoration:underline;font:inherit}
    .qa-item{border:1px solid var(--line);border-radius:8px;padding:.6rem .9rem;margin:.6rem 0}
    .qa-item.ok{border-left:6px solid var(--tip)}
    .qa-item.no{border-left:6px solid var(--warn)}
    .qa-item ul{margin:.3rem 0 0;padding-left:1.2rem}
    .qa-item li.chosen{font-weight:600}
    .qa-item .exp{color:var(--muted);margin:.4rem 0 0}
  </style>
  <script>
    import { supabase } from '../lib/supabase';
    type Syl = { n: number; title: string };
    const SYL: Syl[] = JSON.parse(document.getElementById('a-syl')!.textContent || '[]');
    const msg = document.getElementById('a-msg')!;
    const fail = (t: string) => { msg.textContent = t; msg.className = 'msg err'; };
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const hm = (sec: number) => {
      if (!sec) return '0m';
      const h = Math.floor(sec / 3600), m = Math.round((sec % 3600) / 60);
      return h ? `${h}h ${m}m` : `${m}m`;
    };
    const mins = (sec: number) => String(Math.round((sec || 0) / 60));
    const day = (d?: string | null) => (d ? new Date(d).toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' }) : '');

    (async () => {
      if (!supabase) return fail('The site is not connected to the database.');
      const { data: s } = await supabase.auth.getSession();
      if (!s.session) { msg.innerHTML = `Sign in as an admin to see this page. <a href="${msg.dataset.signin}">Sign in</a>`; return; }
      const { data: users, error: ue } = await supabase.rpc('admin_users');
      if (ue) return fail(ue.message.includes('Admins only') ? 'This page is for admins only.' : ue.message);

      const [quizzes, attempts, progress, times] = await Promise.all([
        supabase.from('quizzes').select('id, module_id, kind, max_attempts'),
        supabase.from('quiz_attempts').select('id, user_id, quiz_id, score_pct, passed, seconds, created_at').not('submitted_at', 'is', null).order('created_at'),
        supabase.from('module_progress').select('user_id, module_id, completed_at'),
        supabase.from('module_time').select('user_id, module_id, seconds, last_seen'),
      ]);
      const err = quizzes.error || attempts.error || progress.error || times.error;
      if (err) return fail(err.message);

      const qById = new Map((quizzes.data || []).map((q: any) => [q.id, q]));
      const finalTries = (quizzes.data || []).find((q: any) => q.kind === 'final')?.max_attempts ?? 2;
      type U = { id: string; email: string; full_name: string; branch: string; role: string; last_sign_in_at: string | null };
      const per = new Map<string, any>();
      for (const u of users as U[]) per.set(u.id, { u, time: {}, att: {}, done: {}, final: [] as any[], last: u.last_sign_in_at });
      const bump = (r: any, t: string) => { if (!r.last || t > r.last) r.last = t; };
      for (const t of times.data || []) { const r = per.get(t.user_id); if (!r) continue; r.time[t.module_id] = t.seconds; bump(r, t.last_seen); }
      for (const p of progress.data || []) { const r = per.get(p.user_id); if (r) r.done[p.module_id] = p.completed_at; }
      for (const a of attempts.data || []) {
        const r = per.get(a.user_id); const q: any = qById.get(a.quiz_id); if (!r || !q) continue;
        bump(r, a.created_at);
        if (q.kind === 'final') r.final.push(a);
        else if (q.kind === 'module') (r.att[q.module_id] ||= []).push(a);
      }

      const rows = [...per.values()];
      const summary = (r: any) => {
        const course = Object.values(r.time).reduce((a: number, b: any) => a + (b as number), 0) as number;
        const quiz = [...Object.values(r.att).flat(), ...r.final].reduce((a: number, b: any) => a + (b.seconds || 0), 0) as number;
        const passed = Object.values(r.att).filter((l: any) => l.some((a: any) => a.passed)).length;
        const fb = r.final.length ? Math.max(...r.final.map((a: any) => a.score_pct)) : null;
        const fp = r.final.some((a: any) => a.passed);
        return { course, quiz, passed, done: Object.keys(r.done).length, final: fb === null ? '' : `${fb}%${fp ? ' passed' : ''} (${r.final.length} of ${finalTries} tries)` };
      };

      const body = document.querySelector('#a-sum tbody')!;
      body.innerHTML = rows.map((r, i) => {
        const s = summary(r);
        return `<tr data-i="${i}"><td>${esc(r.u.email)}${r.u.role !== 'trainee' ? ` <span class="badge">${esc(r.u.role)}</span>` : ''}</td>
          <td>${esc(r.u.full_name)}</td><td>${s.done} of ${SYL.length}</td><td>${mins(s.course)}</td><td>${mins(s.quiz)}</td><td>${mins(s.course + s.quiz)}</td>
          <td>${s.passed} of ${SYL.length}</td><td>${esc(s.final) || 'Not taken'}</td><td>${esc(day(r.last))}</td></tr>`;
      }).join('');

      let current: any = null;
      const tryBtn = (a: any, label: string) =>
        `<button type="button" class="try ${a.passed ? 'pass' : 'fail'}" data-attempt="${a.id}" data-label="${esc(label)}">${a.score_pct}%</button> <small>${esc(day(a.created_at))}${a.seconds ? `, ${mins(a.seconds)} min` : ''}</small>`;

      const showAnswers = async (id: number, label: string) => {
        const box = document.getElementById('qa')!, out = document.getElementById('qa-body')!;
        const a = [...Object.values(current.att).flat(), ...current.final].find((x: any) => x.id === id) as any;
        document.getElementById('qa-title')!.textContent = `${current.u.full_name || current.u.email}: ${label}, ${a.score_pct}% on ${day(a.created_at)}`;
        out.innerHTML = '<p>Loading…</p>';
        box.classList.remove('hidden');
        const { data, error } = await supabase!.rpc('admin_attempt_answers', { p_attempt_id: id });
        if (error) { out.innerHTML = `<p class="msg err">${esc(error.message)}</p>`; return; }
        out.innerHTML = (data || []).map((q: any, n: number) => {
          const ch: string[] = q.choices || [];
          const picked = new Set<number>(q.chosen || []), right = new Set<number>(q.correct_choices || []);
          return `<div class="qa-item ${q.is_correct ? 'ok' : 'no'}"><b>${n + 1}. ${q.is_correct ? 'Correct' : 'Missed'}</b> <small>${esc(q.code || '')}</small><br>${esc(q.prompt)}
            <ul>${ch.map((c, i) => `<li class="${picked.has(i) ? 'chosen' : ''}">${esc(c)}${picked.has(i) ? ' <span class="badge">Trainee answer</span>' : ''}${right.has(i) ? ' <span class="badge done">Correct answer</span>' : ''}</li>`).join('')}</ul>
            ${q.explanation ? `<p class="exp">${esc(q.explanation)}</p>` : ''}</div>`;
        }).join('') || '<p>No answers saved for this attempt.</p>';
        box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      document.getElementById('d-body')!.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button.try') as HTMLElement | null;
        if (b) showAnswers(Number(b.dataset.attempt), b.dataset.label || 'Quiz');
      });

      const show = (i: number) => {
        const r = rows[i];
        body.querySelectorAll('tr').forEach((tr) => tr.classList.toggle('sel', tr.getAttribute('data-i') === String(i)));
        document.getElementById('d-title')!.textContent = `${r.u.full_name || r.u.email}: module detail`;
        document.getElementById('d-body')!.innerHTML = SYL.map((m) => {
          const list: any[] = r.att[m.n] || [];
          const tries = list.map((a) => tryBtn(a, `Module ${m.n} quiz`)).join('<br>');
          const qsec = list.reduce((t, a) => t + (a.seconds || 0), 0);
          const best = list.length ? Math.max(...list.map((a) => a.score_pct)) + '%' : '';
          const st = r.done[m.n] ? `<span class="badge done">Complete</span> <small>${esc(day(r.done[m.n]))}</small>` : (r.time[m.n] ? 'In progress' : 'Not started');
          return `<tr><td>${m.n}</td><td>${esc(m.title)}</td><td>${mins(r.time[m.n] || 0)}</td><td>${mins(qsec)}</td><td>${tries || 'None'}</td><td>${best}</td><td>${st}</td></tr>`;
        }).join('') + (() => {
          const list: any[] = r.final;
          const best = list.length ? Math.max(...list.map((a) => a.score_pct)) + '%' : '';
          return `<tr><td>Final</td><td>Final exam</td><td></td><td>${mins(list.reduce((t, a) => t + (a.seconds || 0), 0))}</td><td>${list.map((a) => tryBtn(a, 'Final exam')).join('<br>') || 'None'}</td><td>${best}</td><td>${list.some((a) => a.passed) ? '<span class="badge done">Passed</span>' : ''}</td></tr>`;
        })();
        document.getElementById('qa')!.classList.add('hidden');
        current = r;
        const d = document.getElementById('a-detail')!;
        d.classList.remove('hidden');
        d.scrollIntoView({ behavior: 'smooth', block: 'start' });
      };
      body.addEventListener('click', (e) => {
        const tr = (e.target as HTMLElement).closest('tr');
        if (tr) show(Number(tr.getAttribute('data-i')));
      });

      document.getElementById('a-csv')!.addEventListener('click', () => {
        const head = ['Email', 'Name', 'Branch', 'Role', 'Module', 'Title', 'Course minutes', 'Quiz minutes', 'Attempts', 'Scores', 'Best', 'Passed', 'Completed'];
        const out = [head];
        for (const r of rows) for (const m of SYL) {
          const list: any[] = r.att[m.n] || [];
          out.push([r.u.email, r.u.full_name, r.u.branch, r.u.role, String(m.n), m.title,
            mins(r.time[m.n] || 0), mins(list.reduce((t, a) => t + (a.seconds || 0), 0)), String(list.length), list.map((a) => a.score_pct + '%').join(' '),
            list.length ? Math.max(...list.map((a) => a.score_pct)) + '%' : '', list.some((a) => a.passed) ? 'Yes' : 'No',
            r.done[m.n] ? new Date(r.done[m.n]).toLocaleDateString() : '']);
        }
        for (const r of rows) for (const a of r.final) {
          out.push([r.u.email, r.u.full_name, r.u.branch, r.u.role, 'Final', 'Final exam', '', mins(a.seconds || 0), '', a.score_pct + '%', '', a.passed ? 'Yes' : 'No', new Date(a.created_at).toLocaleDateString()]);
        }
        // A leading =, +, -, @, tab, or return makes a spreadsheet run the cell as a formula.
        const cell = (c: unknown) => { const t = String(c ?? ''); return `"${(/^[=+\-@\t\r]/.test(t) ? "'" + t : t).replace(/"/g, '""')}"`; };
        const csv = out.map((row) => row.map(cell).join(',')).join('\r\n');
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv' }));
        a.download = 'trainee-activity.csv';
        a.click();
      });

      msg.classList.add('hidden');
      document.getElementById('a-in')!.classList.remove('hidden');
    })();
  </script>
</Base>
