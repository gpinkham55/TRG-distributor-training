---
import Base from '../../layouts/Base.astro';
import QuizRunner from '../../components/QuizRunner.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
export async function getStaticPaths() {
  const mods = await getCollection('modules');
  return mods.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const d = m.data;
---
<Base title={`Module ${d.number} Quiz`} current="course">
  <QuizRunner eyebrow={`Week ${d.week} · Module ${d.number}`} title={`${d.title}: Module Quiz`} back={u(`modules/${m.slug}`)} backLabel={`Back to Module ${d.number}`} module={d.number} />
</Base>
