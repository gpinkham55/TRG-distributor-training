---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
export async function getStaticPaths() {
  const mods = await getCollection('modules');
  return mods.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const { Content, headings } = await m.render();
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const d = m.data;
---
<Base title={`Module ${d.number}: ${d.title}`} current="course" description={d.summary}>
  <div class="layout">
  <nav class="toc" aria-label="On this page">
    <b>On this page</b>
    {toc.map((h) => <a class={`l${h.depth}`} href={`#${h.slug}`}>{h.text}</a>)}
    <a href="#complete">Finish this module</a>
  </nav>
  <article class="prose">
    <p class="eyebrow">Week {d.week} · Module {d.number}</p>
    <h1>{d.title}</h1>
    <div class="meta">
      <span>About {d.minutes} minutes</span>
      {d.signoff && <span>Manager sign-off required</span>}
    </div>
    <Content />
    <div class="complete" id="complete" data-module={d.number}>
      <h3 style="margin-top:0">Finish this module</h3>
      <p>Pass the module quiz (10 questions, 80% to pass, 3 tries) to mark Module {d.number} complete. Every trainee completes the module and the quiz.{d.signoff && ' The Manager sign-off still applies.'}</p>
      <p id="c-status" class="hidden"></p>
      <div class="quiz-links">
        <a class="btn" href={u(`quiz/${m.slug}`)}>Take the module quiz</a>
        {d.number === 16 && <a class="btn" href={u('quiz/final')}>Take the final exam</a>}
      </div>
    </div>
    <p><a href={u('course')}>Back to the course outline</a></p>
  </article>
  </div>
  <script>
    import { supabase } from '../../lib/supabase';
    // Counts seconds while the page is visible and the trainee has been active
    // in the last 5 minutes, and saves them every 30 seconds.
    function trackTime(moduleId: number) {
      const IDLE_MS = 5 * 60 * 1000;
      let lastActive = Date.now();
      let pending = 0;
      const mark = () => { lastActive = Date.now(); };
      for (const ev of ['mousemove', 'keydown', 'scroll', 'touchstart', 'click']) {
        window.addEventListener(ev, mark, { passive: true });
      }
      const flush = () => {
        if (pending < 1 || !supabase) return;
        const s = pending; pending = 0;
        supabase.rpc('log_module_time', { p_module_id: moduleId, p_seconds: s }).then(({ error }) => {
          if (error) pending += s;
        });
      };
      setInterval(() => {
        if (document.visibilityState === 'visible' && Date.now() - lastActive < IDLE_MS) pending += 1;
        if (pending >= 30) flush();
      }, 1000);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') flush(); else mark();
      });
      window.addEventListener('pagehide', flush);
    }
    const box = document.getElementById('complete')!;
    const id = Number(box.dataset.module);
    (async () => {
      if (!supabase) return;
      const { data } = await supabase.auth.getSession();
      if (!data.session) return;
      trackTime(id);
      const { data: row } = await supabase.from('module_progress').select('completed_at').eq('module_id', id).maybeSingle();
      if (row) {
        const st = document.getElementById('c-status')!;
        st.innerHTML = '<span class="badge done">Complete</span>';
        st.classList.remove('hidden');
      }
    })();
  </script>
</Base>
