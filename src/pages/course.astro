---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { WEEKS, SYLLABUS } from '../data/syllabus';
import { u } from '../lib/url';
const written = new Map((await getCollection('modules')).map((m) => [m.data.number, m]));
---
<Base title="Course" current="course">
  <div class="prose">
    <p class="eyebrow">Course outline</p>
    <h1>Four Weeks, Sixteen Modules</h1>
    <p>Work the modules in order.</p>
  </div>
  <div class="weeks">
    {WEEKS.map((w) => (
      <section class="week">
        <div class="week-h">Week {w.week}: {w.title}</div>
        <ul class="mods">
          {SYLLABUS.filter((m) => m.week === w.week).map((m) => {
            const doc = written.get(m.n);
            return (
              <li data-module={m.n}>
                <span class="num">{m.n}</span>
                <span class="t">{doc ? <a href={u(`modules/${doc.slug}`)}>{m.title}</a> : <span class="soon">{m.title}</span>}</span>
                {!doc && <span class="badge">Coming</span>}
                <span class="badge done hidden">Done</span>
              </li>
            );
          })}
        </ul>
      </section>
    ))}
    <section class="week">
      <div class="week-h">Final Exam</div>
      <ul class="mods"><li><span class="num">F</span><span class="t"><a href={u('quiz/final')}>Final Exam</a></span><span class="badge">48 questions · 85% to pass · 2 tries</span></li></ul>
    </section>
  </div>
  <script>
    import { supabase } from '../lib/supabase';
    (async () => { if (supabase) {
      const { data } = await supabase.auth.getSession();
      if (data.session) {
        const { data: rows } = await supabase.from('module_progress').select('module_id').eq('user_id', data.session.user.id);
        for (const r of rows || []) document.querySelector(`[data-module="${r.module_id}"] .done`)?.classList.remove('hidden');
      }
    } })();
  </script>
</Base>
